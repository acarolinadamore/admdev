{
  "redirects": [
    {
      "source": "/proposta/:slug/contrato",
      "destination": "/contrato/:slug",
      "permanent": true
    },
    {
      "source": "/proposta/:slug/manutencao",
      "destination": "/manutencao/:slug",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/proposta/:path*",
      "destination": "https://propostas.anadamore.com.br/proposta/:path*"
    },
    {
      "source": "/contrato/:path*",
      "destination": "https://propostas.anadamore.com.br/contrato/:path*"
    },
    {
      "source": "/manutencao/:path*",
      "destination": "https://propostas.anadamore.com.br/manutencao/:path*"
    },
    {
      "source": "/checklist/:path*",
      "destination": "https://propostas.anadamore.com.br/checklist/:path*"
    },
    {
      "source": "/tabela-precos",
      "destination": "https://propostas.anadamore.com.br/tabela-precos"
    },
    {
      "source": "/tabela-precos/:path*",
      "destination": "https://propostas.anadamore.com.br/tabela-precos/:path*"
    },
    {
      "source": "/escopo/:path*",
      "destination": "https://propostas.anadamore.com.br/escopo/:path*"
    },
    {
      "source": "/termo-aceite/:path*",
      "destination": "https://propostas.anadamore.com.br/termo-aceite/:path*"
    },
    {
      "source": "/_astro/:path*",
      "destination": "https://propostas.anadamore.com.br/_astro/:path*"
    },
    {
      "source": "/site/:slug/:path*",
      "destination": "https://:slug-demo.grupoadmtecnologia.workers.dev/site/:slug/:path*"
    }
  ]
}
